include LICENSE
include README.md
include .env.example
include tox.ini
include Dockerfile
include .dockerignore
include package.json package-lock.json .node-version eslint.config.js
include .prettierrc.yml .prettierignore stylelint.config.js .hadolint.yaml .yamllint.yaml
include .git-blame-ignore-revs
recursive-include src/cra/app/web/static *
recursive-include src/cra/app/web/templates *
recursive-include src/cra/app/web/brand *
include src/cra/app/web/pipeline.json
recursive-include src/cra/app/history/migrations *
recursive-include src/cra/core/retrieval/bge-small-en-v1.5 *
recursive-include tests *.py *.txt
recursive-include tests/data *
recursive-include developer *
recursive-include .github *
prune journal

# the recursive includes above would otherwise sweep in whatever the
# interpreter left lying about
global-exclude *.py[cod]
global-exclude .DS_Store
prune **/__pycache__

# screenshots for the README, not for the package
prune docs
