# Cluster Research Assistant configuration. Copy to .env and edit.
# Real environment variables take precedence over this file. Every key is
# listed with its default; keys marked "secret" are redacted by `cra check-config`.

# ---- cluster identity -------------------------------------------------------
# short internal name, e.g. e-conversion
CRA_CLUSTER_NAME=cluster
# shown in the browser tab and header
CRA_CLUSTER_DISPLAY_NAME=Cluster Research Assistant
# one clause used in the system prompt
CRA_CLUSTER_DESCRIPTION=a research cluster
# e.g. https://e-conversion.de
CRA_CLUSTER_WEBSITE=
# e.g. Deutsche Forschungsgemeinschaft (DFG)
CRA_CLUSTER_FUNDING_BODY=
# comma-separated, e.g. TUM,LMU
CRA_CLUSTER_HOST_INSTITUTIONS=

# ---- server -----------------------------------------------------------------
# bind address; 0.0.0.0 in a container
CRA_HOST=127.0.0.1
CRA_PORT=8000
# URL prefix when the proxy does not strip it, e.g. /nomad-oasis/api/everse
CRA_BASE_PATH=
# false only for plain-http local runs
CRA_COOKIE_SECURE=true
CRA_SESSION_MAX_AGE_HOURS=12

# ---- corpus -----------------------------------------------------------------
# directory with the corpus files and manifest.json (required)
CRA_CORPUS_PATH=./corpus
# manifest schema version the code accepts
CRA_CORPUS_REQUIRE_SCHEMA=1.x

# ---- tools ------------------------------------------------------------------
# tool modules to load, in cra.core.tools
CRA_TOOL_MODULES=papers,pis,proposal,graph,status,nomad
# public search_fulltext: characters per snippet
CRA_FULLTEXT_SNIPPET_CHARS=200
# public search_fulltext: snippets per call
CRA_FULLTEXT_MAX_SNIPPETS=5

# ---- LLM (one active provider) ----------------------------------------------
# gwdg | openrouter | any OpenAI-compatible name
CRA_LLM_PROVIDER=gwdg
CRA_LLM_BASE_URL=https://chat-ai.academiccloud.de/v1
# secret
CRA_LLM_API_KEY=
# default model; empty on openrouter means cheapest eligible
CRA_LLM_MODEL=
# comma-separated models offered in the UI
CRA_LLM_MODELS=
CRA_LLM_MAX_TOOL_ROUNDS=10
# completion tokens per model call
CRA_LLM_MAX_TOKENS=8192
# history is trimmed to stay below this
CRA_LLM_MAX_CONTEXT_TOKENS=64000
# only with CRA_LLM_PROVIDER=openrouter
CRA_OPENROUTER_MAX_PRICE_PER_MTOK=1.0
# only with CRA_LLM_PROVIDER=openrouter
CRA_OPENROUTER_MIN_AGENTIC_INDEX=35

# ---- auth -------------------------------------------------------------------
# dev | oidc
CRA_AUTH_PROVIDER=dev
# dev: sign everyone in as this user; empty means anonymous
CRA_AUTH_DEV_USER=
# dev: trust this proxy header as the user, e.g. X-Forwarded-User
CRA_AUTH_USER_HEADER=
# shown on login error pages
CRA_AUTH_ADMIN_CONTACT=
# e.g. https://oidc-testproxy.aai.dfn.de
CRA_OIDC_ISSUER=
CRA_OIDC_CLIENT_ID=
# secret
CRA_OIDC_CLIENT_SECRET=
# e.g. https://<host>/auth/callback
CRA_OIDC_REDIRECT_URI=
CRA_OIDC_SCOPES=openid email profile

# ---- outward MCP surface (public tier only) ---------------------------------
CRA_MCP_SERVER_ENABLED=true
CRA_MCP_SERVER_PATH=/mcp
# true needs CRA_MCP_TOKEN_SECRET; tokens via `cra token issue`
CRA_MCP_SERVER_REQUIRE_TOKEN=false
# calls per minute per token or address
CRA_MCP_SERVER_RATE_LIMIT=60
# secret
CRA_MCP_TOKEN_SECRET=

# ---- history ----------------------------------------------------------------
# or postgresql+psycopg://user:pass@host/db
CRA_HISTORY_URL=sqlite+aiosqlite:///./cra.sqlite
CRA_HISTORY_RETENTION_DAYS=365
# true runs `cra db upgrade` on start (containers)
CRA_HISTORY_AUTO_MIGRATE=false

# ---- external MCP servers this instance consumes ----------------------------
# e.g. https://<host>/el/mcp
CRA_MCP_ELAB_URL=
# where users get their token
CRA_MCP_ELAB_REGISTER_URL=
# e.g. https://<host>/dt/mcp
CRA_MCP_DATATAGGER_URL=
CRA_MCP_DATATAGGER_REGISTER_URL=
# close an idle pooled MCP session after this
CRA_MCP_POOL_IDLE_S=600

# ---- connectors -------------------------------------------------------------
CRA_NOMAD_BASE_URL=https://nomad-lab.eu/prod/v1/api/v1
CRA_NOMAD_GUI_URL=https://nomad-lab.eu/prod/v1/gui/entry/id/{}

# ---- query encoder ----------------------------------------------------------
# directory from `cra encoder fetch`; empty disables semantic search
CRA_ENCODER_PATH=
CRA_ENCODER_MODEL=BAAI/bge-small-en-v1.5

# ---- logging ----------------------------------------------------------------
CRA_LOG_DIR=logs
# true logs raw tool arguments (they contain user queries)
CRA_LOG_TOOL_ARGS=false
